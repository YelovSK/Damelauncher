<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Damelauncher" />
    <InternalsVisibleTo Include="Damelauncher.Benchmarks" />
    <InternalsVisibleTo Include="Damelauncher.Tests" />
    <InternalsVisibleTo Include="Damelauncher.Plugins.Programs" />
    <InternalsVisibleTo Include="Damelauncher.Plugins.WindowsSettings" />
    <InternalsVisibleTo Include="Damelauncher.Plugins.Everything" />
  </ItemGroup>

</Project>
